    "<% .SecondService | snake %>_not_found": "<% .SecondService %> não encontrado",
    "<% .SecondService | snake %>_already_exists": "<% .SecondService %> já existe: {{reason}}",
    "<% .SecondService | snake %>_invalid_status": "Status de <% .SecondService %> inválido: {{reason}}",
    "<% .MixedService | snake %>_not_found": "<% .MixedService %> não encontrado",
